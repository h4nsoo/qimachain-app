# QīmaChain Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Google Gemini API (for LLM certificate extraction)
# ============================================
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ============================================
# Blockchain Configuration
# ============================================

# Ethereum RPC URL (Infura, Alchemy, or local node)
# Examples:
#   Mainnet: https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
#   Sepolia: https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
#   Polygon: https://polygon-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Deployed QimaChainNFT smart contract address
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Network Chain ID
# 1 = Ethereum Mainnet
# 11155111 = Sepolia Testnet
# 137 = Polygon Mainnet
# 80001 = Polygon Mumbai Testnet
CHAIN_ID=11155111

# Private key of the minting wallet (KEEP SECRET!)
# This wallet needs ETH for gas and should have MINTER_ROLE on contract
# Format: 64-character hex string (without 0x prefix)
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# ============================================
# IPFS Configuration (Pinata)
# ============================================

# Get API keys from: https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_api_key_here

# ============================================
# Optional: Development Settings
# ============================================

# Device for PyTorch (cuda or cpu)
# DEVICE=cuda

# Image processing size
# IMAGE_SIZE=224
